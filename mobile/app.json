{
  "expo": {
    "name": "상사 패기",
    "slug": "sangsa-hit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14161F",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14161F",
        "foregroundImage": "./assets/splash-art.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14161F",
          "image": "./assets/splash-art.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      "expo-image"
    ]
  }
}
